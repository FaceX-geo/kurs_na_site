{
  "catalog_version": "1.1.0",
  "concurrency": "optimistic",
  "version_conflict": {
    "http_status": 409,
    "code": "VERSION_CONFLICT"
  },
  "transactional_invariants": [
    "aggregate_update",
    "aggregate_history",
    "mandatory_audit_event",
    "required_outbox_event"
  ],
  "unknown_transition": "deny",
  "selector_schema": {
    "single_state": "from/to",
    "state_group": "from_set/to_set",
    "wildcards_and_pipe_composites": "forbidden",
    "to_set_requires": ["target_state_field", "target_guard"]
  },
  "state_machines": {
    "crm_relocation_case": {
      "initial_state": "new",
      "terminal_states": [],
      "states": [
        "new",
        "qualification",
        "documents",
        "employer_selection",
        "employer_review",
        "offer",
        "relocation_preparation",
        "moved",
        "closed_unsuccessful"
      ],
      "state_sets": {
        "open": [
          "new",
          "qualification",
          "documents",
          "employer_selection",
          "employer_review",
          "offer",
          "relocation_preparation"
        ],
        "reopen_targets": [
          "new",
          "qualification",
          "documents",
          "employer_selection",
          "employer_review",
          "offer",
          "relocation_preparation"
        ]
      },
      "transitions": [
        {
          "from": null,
          "to": "new",
          "permission": "crm.case.create",
          "required": ["application", "source", "consent_version"]
        },
        {
          "from": "new",
          "to": "qualification",
          "permission": "crm.case.transition",
          "required": ["owner_id", "next_step"]
        },
        {
          "from": "qualification",
          "to": "documents",
          "permission": "crm.case.transition",
          "required": ["program_type", "normalized_contact"]
        },
        {
          "from": "documents",
          "to": "employer_selection",
          "permission": "crm.case.transition",
          "required": ["document_decision"]
        },
        {
          "from": "employer_selection",
          "to": "employer_review",
          "permission": "crm.case.transition",
          "required": ["employer_referral_id"]
        },
        {
          "from": "employer_review",
          "to": "offer",
          "permission": "crm.case.transition",
          "required": ["approved_referral_id"]
        },
        {
          "from": "offer",
          "to": "relocation_preparation",
          "permission": "crm.case.transition",
          "required": ["employer_id", "job_title", "agreement_result"]
        },
        {
          "from": "relocation_preparation",
          "to": "moved",
          "permission": "crm.case.transition",
          "required": ["municipality", "locality", "actual_relocation_date", "employer_id", "job_title"]
        },
        {
          "from_set": "open",
          "to": "closed_unsuccessful",
          "permission": "crm.case.transition",
          "required": ["reason_code"]
        },
        {
          "from": "closed_unsuccessful",
          "to_set": "reopen_targets",
          "target_state_field": "target_state",
          "target_guard": {
            "type": "equals_history_field",
            "field": "last_open_state"
          },
          "permission": "crm.case.reopen",
          "required": ["reason", "target_state"]
        },
        {
          "from": "moved",
          "to": "relocation_preparation",
          "permission": "crm.case.reopen",
          "required": ["reason", "correction_evidence"]
        }
      ]
    },
    "crm_student_case": {
      "initial_state": "new",
