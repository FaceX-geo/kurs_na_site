    "migration_run": {
      "initial_state": "created",
      "terminal_states": ["failed", "rolled_back", "cancelled"],
      "states": [
        "created",
        "profiling",
        "dry_running",
        "awaiting_conflicts",
        "ready_for_rehearsal",
        "rehearsing",
        "ready_for_cutover",
        "cutting_over",
        "completed",
        "failed",
        "rolled_back",
        "cancelled"
      ],
      "state_sets": {
        "rehearsal_sources": ["dry_running", "awaiting_conflicts"],
        "active": [
          "created",
          "profiling",
          "dry_running",
          "awaiting_conflicts",
          "ready_for_rehearsal",
          "rehearsing",
          "ready_for_cutover",
          "cutting_over"
        ],
        "rollbackable": ["cutting_over", "completed"],
        "pre_cutover": [
          "created",
          "profiling",
          "dry_running",
          "awaiting_conflicts",
          "ready_for_rehearsal",
          "rehearsing",
          "ready_for_cutover"
        ]
      },
      "transitions": [
        {
          "from": "created",
          "to": "profiling",
          "permission": "migration.run.execute",
          "required": ["snapshot_checksum", "manifest_version"]
        },
        {
          "from": "profiling",
          "to": "dry_running",
          "permission": "migration.run.execute",
          "required": ["schema_and_count_match_manifest"]
        },
        {
          "from": "dry_running",
          "to": "awaiting_conflicts",
          "permission": "migration.run.execute",
          "required": ["blocking_items_present"]
        },
        {
          "from_set": "rehearsal_sources",
          "to": "ready_for_rehearsal",
          "permission": "migration.run.execute",
          "required": ["coverage_100", "blocking_items_zero"]
        },
        {
          "from": "ready_for_rehearsal",
          "to": "rehearsing",
          "permission": "migration.run.execute",
          "required": ["target_backup", "approved_window"]
        },
        {
          "from": "rehearsing",
          "to": "ready_for_cutover",
          "permission": "migration.run.execute",
          "required": ["rollback_rehearsal", "reconciliation_pass"]
        },
        {
          "from": "ready_for_cutover",
          "to": "cutting_over",
          "permission": "migration.cutover.execute",
          "required": ["fresh_snapshot", "freeze_or_cdc", "final_delta", "signed_go_no_go"]
        },
        {
          "from": "cutting_over",
          "to": "completed",
          "permission": "migration.cutover.execute",
          "required": ["traffic_switch", "post_switch_verification"]
        },
        {
          "from_set": "active",
          "to": "failed",
          "permission": "system.migration_fail"
        },
        {
          "from_set": "rollbackable",
          "to": "rolled_back",
          "permission": "migration.rollback.execute",
          "required": ["decision_tree", "reverse_delta_or_signed_owner_decision"]
        },
        {
          "from_set": "pre_cutover",
          "to": "cancelled",
          "permission": "migration.run.execute",
          "required": ["reason", "no_cutover_started"]
        }
      ]
    },
    "migration_conflict": {
      "initial_state": "open",
