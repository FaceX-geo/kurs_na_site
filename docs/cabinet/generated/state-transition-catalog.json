        {
          "from": "drafting",
          "to": "ready",
          "permission": "ai.assist.read",
          "required": ["deterministic_validation", "immutable_hash"]
        },
        {
          "from": "ready",
          "to": "confirmed",
          "permission": "ai.task.confirm_domain",
          "required": ["same_human_actor", "unexpired", "rbac_version_hash_recheck"]
        },
        {
          "from": "confirmed",
          "to": "executing",
          "permission": "ai.task.confirm_domain",
          "required": ["one_time_idempotency_key"]
        },
        {
          "from": "executing",
          "to": "completed",
          "permission": "system.ai_finalize"
        },
        {
          "from": "executing",
          "to": "partially_completed",
          "permission": "system.ai_finalize"
        },
        {
          "from_set": "nonterminal",
          "to": "invalidated",
          "permission": "system.ai_invalidate"
        },
        {
          "from_set": "nonterminal",
          "to": "expired",
          "permission": "system.ai_expire"
        },
        {
          "from_set": "pre_execute",
          "to": "cancelled",
          "permission": "ai.assist.read",
          "required": ["same_human_actor"]
        },
        {
          "from": "executing",
          "to": "failed",
          "permission": "system.ai_finalize",
          "required": ["terminal_error", "per_item_results"]
        }
      ]
    },
    "ai_batch_job_item": {
      "initial_state": "pending",
      "terminal_states": ["created", "skipped", "conflict", "forbidden", "failed", "cancelled"],
      "states": ["pending", "validated", "created", "skipped", "conflict", "forbidden", "failed", "cancelled"],
      "state_sets": {
        "cancellable": ["pending", "validated"]
      },
      "transitions": [
        {
          "from": null,
          "to": "pending",
          "permission": "ai.batch.draft",
          "required": ["draft_id", "source_object_id", "source_object_version"]
        },
        {
          "from": "pending",
          "to": "validated",
          "permission": "ai.batch.confirm",
          "required": ["same_human_actor", "rbac_recheck", "source_version_recheck"]
        },
        {
          "from": "validated",
          "to": "created",
          "permission": "ai.batch.confirm",
          "required": ["validated_domain_command", "idempotency_key", "target_id", "audit_event_id"]
        },
        {
          "from": "validated",
          "to": "skipped",
          "permission": "system.ai_finalize",
          "required": ["reason_code"]
        },
        {
          "from": "validated",
          "to": "conflict",
          "permission": "system.ai_finalize",
          "required": ["version_or_selection_conflict"]
        },
        {
          "from": "validated",
          "to": "forbidden",
          "permission": "system.ai_finalize",
          "required": ["rbac_or_membership_denial"]
        },
        {
          "from": "validated",
          "to": "failed",
          "permission": "system.ai_finalize",
          "required": ["error_code", "no_partial_domain_mutation"]
        },
        {
          "from_set": "cancellable",
          "to": "cancelled",
          "permission": "ai.batch.confirm",
          "required": ["same_human_actor", "reason"]
        }
      ]
    },
    "message_delivery": {
      "initial_state": "draft",
      "terminal_states": ["delivered", "failed_terminal", "cancelled"],
      "states": [
        "draft",
        "confirmed",
        "queued",
        "sending",
        "sent",
        "delivered",
        "failed_retryable",
        "failed_terminal",
        "cancelled"
      ],
      "state_sets": {
        "retry_failure_sources": ["sending", "sent"],
        "active": ["queued", "sending", "sent", "failed_retryable"],
        "pre_send": ["draft", "confirmed", "queued"]
      },
      "transitions": [
        {
          "from": "draft",
          "to": "confirmed",
          "permission": "crm.communication.confirm",
          "required": ["human_preview_confirm"]
        },
        {
          "from": "confirmed",
          "to": "queued",
          "permission": "crm.communication.send",
          "required": ["outbox_transaction", "idempotency_key"]
        },
        {
          "from": "queued",
          "to": "sending",
          "permission": "system.message_worker",
          "required": ["worker_lease"]
        },
        {
          "from": "sending",
          "to": "sent",
          "permission": "system.message_worker",
          "required": ["provider_acceptance"]
        },
        {
          "from": "sent",
          "to": "delivered",
          "permission": "system.message_callback"
        },
        {
          "from_set": "retry_failure_sources",
          "to": "failed_retryable",
          "permission": "system.message_worker"
        },
        {
          "from": "failed_retryable",
          "to": "queued",
          "permission": "system.message_worker",
          "required": ["same_idempotency_key", "backoff"]
        },
        {
          "from_set": "active",
          "to": "failed_terminal",
          "permission": "system.message_worker"
        },
        {
          "from_set": "pre_send",
          "to": "cancelled",
          "permission": "crm.communication.cancel"
        }
      ]
    }
  },
  "consistency_checks": [
    "every_mutable_aggregate_registered",
    "every_stored_state_has_transition_or_terminal_marker",
    "every_transition_has_allow_and_deny_test",
    "every_transition_checks_expected_version",
    "every_critical_transition_writes_audit",
    "every_external_side_effect_uses_outbox",
    "ui_api_kanban_ai_have_no_bypass_update_endpoint"
  ]
}
