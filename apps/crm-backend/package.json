{
  "name": "@kurs-na-sever/crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:once": "node dist/worker-once.js",
    "credential-worker": "node dist/credential-worker.js",
    "uploads:reconcile": "node dist/upload-reconciler-once.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:status": "tsx scripts/migrate.ts status",
    "db:rollback": "tsx scripts/migrate.ts down",
    "identity:bootstrap": "tsx scripts/bootstrap-identity.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "contracts:check": "tsx scripts/check-contracts.ts",
    "migration:preflight": "tsx scripts/migrate-legacy.ts preflight",
    "migration:rehearse-transforms": "tsx scripts/rehearse-migration-transforms.ts",
    "migration:verify-projections": "tsx scripts/verify-migration-projections.ts",
    "migration:run": "tsx scripts/migrate-legacy.ts run",
    "migration:test-snapshot": "tsx src/test-snapshot-import-once.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:generate && pnpm contracts:check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.11.2",
    "kysely": "^0.29.4",
    "minio": "^8.0.7",
    "mysql2": "^3.23.2",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.7",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.16.0"
}
